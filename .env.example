# LLM provider (pick one; keep both wired behind one abstraction)
LLM_PROVIDER=openai            # or anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# DataHub
DATAHUB_MODE=mock              # mock | real
DATAHUB_GMS_URL=
DATAHUB_GMS_TOKEN=
DATAHUB_MUTATION_ENABLED=false # app-side gate; ALSO requires
                                # TOOLS_IS_MUTATION_ENABLED=true on the
                                # DataHub MCP server itself for real writes

# GitHub
GITHUB_TOKEN=
GITHUB_DEMO_REPO=              # owner/repo of the throwaway seeded repo

# App
CHECKPOINT_DB_PATH=./data-firefighter-checkpoints.db
